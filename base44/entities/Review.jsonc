{
  "name": "Review",
  "type": "object",
  "properties": {
    "order_id": { "type": "string" },
    "reviewer_email": { "type": "string" },
    "reviewer_name": { "type": "string" },
    "reviewee_email": { "type": "string" },
    "reviewee_name": { "type": "string" },
    "rating": { "type": "number", "minimum": 1, "maximum": 5 },
    "comment": { "type": "string" },
    "type": { "type": "string", "enum": ["creator_to_runner", "runner_to_creator"] }
  },
  "required": ["order_id", "reviewer_email", "reviewee_email", "rating"]
}
