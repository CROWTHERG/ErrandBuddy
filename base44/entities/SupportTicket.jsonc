{
  "name": "SupportTicket",
  "type": "object",
  "properties": {
    "user_email": { "type": "string" },
    "user_name": { "type": "string" },
    "subject": { "type": "string" },
    "message": { "type": "string" },
    "status": { "type": "string", "enum": ["pending", "done"], "default": "pending" },
    "admin_reply": { "type": "string" }
  },
  "required": ["user_email", "subject", "message"]
}
